rules_version = '2';

// sande Firestore Security Rules
// Tenant isolation: a user may only touch data belonging to a business
// where they hold an ACTIVE membership. Branch scoping is enforced on
// operational documents. Membership status and role are always read from
// the server copy, never from the client.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper functions ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function memberDoc(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    function isMember(businessId) {
      return isSignedIn() && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));
    }

    function isActiveMember(businessId) {
      return isMember(businessId) && memberDoc(businessId).data.status == 'ACTIVE';
    }

    function hasRole(businessId, roles) {
      return isActiveMember(businessId) && memberDoc(businessId).data.role in roles;
    }

    function isOwner(businessId) {
      return hasRole(businessId, ['OWNER']);
    }

    function isManager(businessId) {
      return hasRole(businessId, ['OWNER', 'MANAGER']);
    }

    function isStaff(businessId) {
      return hasRole(businessId, ['OWNER', 'MANAGER', 'SALESPERSON']);
    }

    function ownsDoc(businessId) {
      return isActiveMember(businessId) && resource.data.businessId == businessId;
    }

    function writesDoc(businessId) {
      return isActiveMember(businessId) && request.resource.data.businessId == businessId;
    }

    function isValidProduct() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.priceCents is number
        && request.resource.data.priceCents >= 0
        && request.resource.data.businessId is string;
    }

    function isValidMovement() {
      return request.resource.data.productId is string
        && request.resource.data.type in ['SALE', 'RECEIVE', 'ADJUST', 'VOID']
        && request.resource.data.quantity is number
        && request.resource.data.businessId is string;
    }

    function isValidSale() {
      return request.resource.data.receiptNumber is string
        && request.resource.data.totalCents is number
        && request.resource.data.totalCents >= 0
        && request.resource.data.businessId is string
        && request.resource.data.deviceId is string
        && request.resource.data.lineItems is list;
    }

    // ---------- Business documents ----------

    match /businesses/{businessId} {
      // Only members can read the business. Non-members cannot even see it exists.
      allow read: if isActiveMember(businessId);

      // Only the owner can create a business (creator becomes owner via function).
      allow create: if isSignedIn();

      // Owner manages business settings.
      allow update, delete: if isOwner(businessId);

      // ---------- Memberships ----------

      match /members/{uid} {
        // A member can read their own membership.
        // Owners and managers can read all memberships in their business.
        allow read: if isSignedIn() && (uid == request.auth.uid || isManager(businessId));

        // Only owners can create, update or remove memberships.
        allow create, update, delete: if isOwner(businessId);

        // A user may delete their own membership (leave the business).
        allow delete: if isSignedIn() && uid == request.auth.uid;
      }

      // ---------- Branches ----------

      match /branches/{branchId} {
        allow read: if isStaff(businessId);
        allow create, update, delete: if isManager(businessId);

        // Branch-scoped operational documents.
        match /products/{productId} {
          allow read: if isStaff(businessId);
          allow create: if isManager(businessId) && writesDoc(businessId) && isValidProduct();
          allow update: if isManager(businessId) && writesDoc(businessId) && isValidProduct();
          allow delete: if isOwner(businessId);
        }

        match /movements/{movementId} {
          allow read: if isStaff(businessId);
          // Movements are append-only: no updates, no deletes.
          // Creation is trusted-server-only to protect the ledger.
          allow create: if false;
          allow update, delete: if false;
        }

        match /sales/{saleId} {
          allow read: if isStaff(businessId);
          // Sales are created by Cloud Functions (trusted server) for idempotency.
          allow create: if false;
          allow update, delete: if false;
        }

        match /audit/{auditId} {
          allow read: if isOwner(businessId);
          allow write: if false;
        }
      }

      // ---------- Business-level (branch-agnostic) documents ----------

      match /categories/{categoryId} {
        allow read: if isStaff(businessId);
        allow create, update: if isManager(businessId) && writesDoc(businessId);
        allow delete: if isManager(businessId);
      }

      match /units/{unitId} {
        allow read: if isStaff(businessId);
        allow create, update, delete: if isManager(businessId) && writesDoc(businessId);
      }

      match /devices/{deviceId} {
        // A device registers itself for the signed-in user.
        allow read: if isStaff(businessId);
        allow create: if isSignedIn() && writesDoc(businessId);
        allow update: if isSignedIn() && writesDoc(businessId);
        allow delete: if isOwner(businessId);
      }

      match /settings/{settingId} {
        allow read: if isActiveMember(businessId);
        allow write: if isOwner(businessId);
      }
    }

    // ---------- Global user profile ----------

    // A user's own profile is independent of any business membership.
    match /users/{uid} {
      allow read, write: if isSignedIn() && uid == request.auth.uid;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
